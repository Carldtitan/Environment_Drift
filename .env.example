# IWOMC Rescue - configuration template.
#
# This file names variables. It carries no values, and the repository secret
# scan fails if anyone gives one a value here. Set real values in your own
# environment or secret manager.
#
# IWOMC works with none of these set: local mode binds projects, captures,
# verifies in a fresh directory, and rescues on this machine.

# ---------------------------------------------------------------------------
# Local Companion
# ---------------------------------------------------------------------------

# Where IWOMC keeps this device's encrypted store, signing key, and config.
# Defaults to ~/.iwomc
IWOMC_HOME=

# Port the Rescue Console listens on with `iwomc serve`. Defaults to 4319.
IWOMC_CONSOLE_PORT=

# Turn off durable memory entirely for a process. Any value other than 1 is
# ignored; without it IWOMC probes for a Claude-Mem worker and reports honestly.
IWOMC_DISABLE_MEMORY=

# ---------------------------------------------------------------------------
# Team control plane
# ---------------------------------------------------------------------------

# Base URL of a hosted control plane. `iwomc serve` sets this for you when it
# runs one locally.
IWOMC_CONTROL_PLANE_URL=
IWOMC_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# GitHub App (identity and private-repository source access)
# ---------------------------------------------------------------------------
# Without these, IWOMC stays in local-only mode and says so. It never
# substitutes a stand-in identity.

IWOMC_GITHUB_APP_ID=
IWOMC_GITHUB_APP_CLIENT_ID=
IWOMC_GITHUB_APP_PRIVATE_KEY=
IWOMC_GITHUB_API_URL=

# ---------------------------------------------------------------------------
# Modal (clean verification)
# ---------------------------------------------------------------------------
# Prefer `modal token set --token-id <id> --token-secret <secret>`, which writes
# ~/.modal.toml. These variables are the alternative.

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROFILE=

# Hard ceiling on Modal spend for this installation, in USD. Defaults to 30.00.
# Verification refuses to start when the remaining budget cannot cover a run.
IWOMC_MODAL_BUDGET_USD=

# Set to 1 to allow the credential-gated live Modal test to run.
IWOMC_MODAL_LIVE_TEST=

# ---------------------------------------------------------------------------
# Claude-Mem worker (durable, redacted memory)
# ---------------------------------------------------------------------------
# IWOMC resolves the local worker automatically. Override only if yours is
# somewhere else.

CLAUDE_MEM_BASE_URL=
CLAUDE_MEM_WORKER_HOST=
CLAUDE_MEM_WORKER_PORT=
CLAUDE_MEM_DATA_DIR=

# ---------------------------------------------------------------------------
# Durable Postgres for a hosted control plane
# ---------------------------------------------------------------------------
# Unset, the control plane uses its local SQLite store. Set but unreachable, it
# fails loudly rather than writing somewhere else.

IWOMC_DATABASE_URL=
IWOMC_DATABASE_SCHEMA=
IWOMC_DATABASE_MAX_CONNECTIONS=
IWOMC_DATABASE_SSL=

# ---------------------------------------------------------------------------
# Object store for bounded logs and artifacts
# ---------------------------------------------------------------------------
# Unset, bounded logs stay in the device's local encrypted store.

IWOMC_OBJECT_STORE_ENDPOINT=
IWOMC_OBJECT_STORE_BUCKET=
IWOMC_OBJECT_STORE_ACCESS_KEY_ID=
IWOMC_OBJECT_STORE_SECRET_ACCESS_KEY=
