{
  "name": "@iwomc/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The iwomc command line and local MCP server.",
  "bin": { "iwomc": "./dist/bin.js" },
  "main": "./dist/cli.js",
